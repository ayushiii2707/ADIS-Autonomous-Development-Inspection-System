# Optional. Copy to .env (never commit .env). `npm start` works without it.

# Model access for the idea (Elephant–Goldfish) workflow. Leave unset to run
# without AI; repository onboarding works either way.
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_PROVIDER=OpenAI-compatible
# Lower this for small per-minute token limits (e.g. 1 on free tiers).
# AI_MAX_CONCURRENCY=4

# Name, role, and workspace title shown in the app.
# ADIS_USER_NAME=Local user
# ADIS_USER_ROLE=Owner
# ADIS_WORKSPACE_NAME=My workspace

# Server address. Defaults: 127.0.0.1:8787. Another HOST exposes the app to
# your network without sign-in; list the host name you browse to here:
# PORT=8787
# HOST=127.0.0.1
# ALLOWED_HOSTS=

# SQLite database file. Default: .data/adis-local.sqlite
# LOCAL_DB_PATH=.data/adis-local.sqlite

# Credential encryption key (base64, 32 bytes). Leave unset: on first start the
# server creates .data/credential.key and reuses it. Only set this to share an
# existing key; changing it makes stored repository credentials unreadable.
# CREDENTIAL_ENCRYPTION_KEY=

# Security scanning (Operate page). See README "Security scanning".
# Key for the pipeline's AI report step (OpenAI by default). Scans are disabled until set.
# SCAN_AI_API_KEY=
# SCAN_AI_PROVIDER=openai-codex
# SCAN_AI_MODEL=
# SCAN_AI_BUDGET_USD=2
# SCAN_SCANNERS=codeql,opengrep,trivy,osv,trufflehog
# SCAN_WORKER_URL=http://127.0.0.1:4101
